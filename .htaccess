ErrorDocument 404 /erreur404.php

Options -Indexes

RewriteEngine On
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Interdit l'accès HTTP aux répertoires internes et aux archives de données.
RewriteRule ^(?:\.git|\.impeccable|BDD|BDD_A_Exporter|config|functions|includes|controllers|classes|tests)(?:/|$) - [F,L,NC]

<FilesMatch "(^\.env$|^\.DS_Store$|\.(?:sql|mwb.*|md|log|bak)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
